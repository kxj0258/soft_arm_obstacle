<!-- tasks/arm2d/assets/arm_2d_template.xml -->
<mujoco model="arm2d" tendon="enable">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <default class="arm">
      <geom type="cylinder" size="0.02 0.10" rgba="0 0 1 1" mass="0.05"/>
      <joint axis="0 0 1" limited="true" range="-120 120" damping="1"/>
    </default>
    <!-- 绳默认 -->
    <tendon>
      <fixed width="0.005" rgba="1 0 0 1"/>
    </tendon>
  </default>

  <worldbody>
    <!-- 锚点 -->
    <body name="base" pos="0 0 0">
      <site name="anchorL" pos="0  0.03 0"/>
      <site name="anchorR" pos="0 -0.03 0"/>
    </body>

    <!-- 初始 2 段 -->
    <body name="seg0" pos="0.1 0 0">
      <geom class="arm" fromto="0 0 0 0.2 0 0"/>
      <joint name="j0" class="arm"/>
      <site name="sL0" pos="0  0.03 0"/>
      <site name="sR0" pos="0 -0.03 0"/>
      <body name="seg1" pos="0.2 0 0">
        <geom class="arm" fromto="0 0 0 0.2 0 0"/>
        <joint name="j1" class="arm"/>
        <site name="sL1" pos="0  0.03 0"/>
        <site name="sR1" pos="0 -0.03 0"/>
      </body>
    </body>

    <!-- 障碍 -->
    <body name="obs1" pos="0.5  0.2 0"><geom type="sphere" size="0.1" rgba="1 0 0 1" mass="0"/></body>
    <body name="obs2" pos="0.8 -0.15 0"><geom type="sphere" size="0.1" rgba="1 0 0 1" mass="0"/></body>

    <!-- 目标 -->
    <body name="target" pos="1.2 0.3 0"><geom type="sphere" size="0.04" rgba="0 1 0 1" mass="0"/></body>
  </worldbody>

  <tendon>
    <!-- 左绳 -->
    <fixed name="left"  stiffness="400" damping="3">
      <site site="anchorL"/>
      <site site="sL0"/>
      <site site="sL1"/>
    </fixed>
    <!-- 右绳 -->
    <fixed name="right" stiffness="400" damping="3">
      <site site="anchorR"/>
      <site site="sR0"/>
      <site site="sR1"/>
    </fixed>
  </tendon>

  <actuator>
    <motor name="left_m"  tendon="left"  gear="0.02" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="right_m" tendon="right" gear="0.02" ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>
</mujoco>